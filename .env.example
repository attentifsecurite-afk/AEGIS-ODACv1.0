# 🔐 AEGIS-ODAC Environment Variables
# Ce fichier contient les clés API et configurations sensibles
# NE JAMAIS COMMITER CE FICHIER DANS GIT

# ============================================
# AUTHENTIFICATION
# ============================================
ADMIN_PASSWORD=Creteil@2026
SESSION_SECRET=aegis_odac_ultra_secret_key_2026_chained_ed25519
JWT_SECRET=jwt_aegis_secret_key_never_share_this_2026

# ============================================
# API KEYS - MODÈLES IA
# ============================================
# HuggingFace Inference API
HF_API_KEY=hf_your_huggingface_api_key_here
HF_ORGANIZATION=aegis_odac

# OpenRouter (fallback)
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# ============================================
# INFRASTRUCTURE
# ============================================
# ZeroMQ Bus
ZMQ_PUB_PORT=5555
ZMQ_SUB_PORT=5556
ZMQ_BIND_ADDRESS=tcp://*:5555

# Redis (cache & sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# PostgreSQL (TimescaleDB)
DATABASE_URL=postgresql://aegis:your_db_password@localhost:5432/aegis_odac
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=aegis_odac
TIMESCALE_USER=aegis
TIMESCALE_PASSWORD=your_timescale_password

# ============================================
# SÉCURITÉ & CHIFFREMENT
# ============================================
# Clé de chiffrement pour .env (AES-256-GCM)
ENV_ENCRYPTION_KEY=your_32_byte_encryption_key_here
ENV_ENCRYPTION_IV=your_12_byte_iv_here

# Ed25519 Proof Chain
PROOF_CHAIN_PRIVATE_KEY_PATH=./keys/odac_ed25519.key
PROOF_CHAIN_PUBLIC_KEY=your_public_key_hex_here

# ============================================
# JARVIS CONFIGURATION
# ============================================
# Modèles IA
GEMMA_MODEL_ID=google/gemma-3-27b-it
QWEN_MODEL_ID=Qwen/Qwen2.5-32B
GLM_MODEL_ID=THUDM/glm-4-9b-chat
DEEPSEEK_MODEL_ID=deepseek-ai/DeepSeek-V3.2

# TGI Endpoints
TGI_GEMMA_ENDPOINT=http://localhost:8080
TGI_QWEN_ENDPOINT=http://localhost:8081
TGI_GLM_ENDPOINT=http://localhost:8082

# ============================================
# DÉTECTION & CAPTEURS
# ============================================
# Aero-Sense Bridge
AEROSENSE_UDP_PORT=5006
AEROSENSE_HOST=0.0.0.0

# SDR (sdroxide)
SDR_SAMPLE_RATE=2048000
SDR_CENTER_FREQ=2400000000
SDR_GAIN=40

# Caméras PTZ
PTZ_CAMERA_1_URL=rtsp://admin:password@192.168.1.100:554/stream
PTZ_CAMERA_2_URL=rtsp://admin:password@192.168.1.101:554/stream

# ============================================
# COMMUNICATIONS
# ============================================
# Meshpoint LoRa
MESHPOINT_API_KEY=your_meshpoint_api_key
LORA_FREQUENCY=868000000
LORA_SPREADING_FACTOR=12

# ThingsBoard
THINGSBOARD_URL=http://localhost:9090
THINGSBOARD_ACCESS_TOKEN=your_thingsboard_token

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/aegis-odac/system.log
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ============================================
# DOCTRINE & ROE
# ============================================
# Actions automatiques autorisées
AUTO_ACTIONS=alert_agent,cue_ptz,log_proof,notify_supervisor

# Actions requièrent validation humaine
HUMAN_REQUIRED_ACTIONS=jam,spoof_gps,kinetic,lock_access,deploy_counter_drone

# Seuils de confiance
CONFIRMATION_THRESHOLD=0.85
NOTIFICATION_THRESHOLD=0.60

# ============================================
# DÉPLOIEMENT
# ============================================
NODE_ENV=production
API_PORT=3000
FRONTEND_URL=https://fb472361-b861-44c1-a09f-d14b513aa00a.preview.qwenlm.io
BACKEND_URL=https://api.aegis-odac.local

# ============================================
# RATE LIMITING & SÉCURITÉ
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=https://fb472361-b861-44c1-a09f-d14b513aa00a.preview.qwenlm.io

# ============================================
# BACKUP & RECOVERY
# ============================================
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key
BACKUP_S3_BUCKET=aegis-odac-backups
BACKUP_S3_REGION=eu-west-3
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
